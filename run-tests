#!/usr/bin/env -S emacs --script

;;; run-tests --- Run ERT test suite -*- lexical-binding: t; -*-

(require 'seq)
(require 'ert)
(require 'package)

(defconst mcpkit-test-runner--root
  (file-name-directory (or load-file-name buffer-file-name))
  "Directory this script lives in -- the package root.")

(defconst mcpkit-test-runner--deps-dir
  (expand-file-name ".deps" mcpkit-test-runner--root)
  "Directory holding fetched dependencies, gitignored and cached across runs.")

(defconst mcpkit-test-runner--packages
  '(compat web-server)
  "Packages fetched from GNU ELPA/MELPA via package.el.")

(defun mcpkit-test-runner--ensure-packages ()
  "Install any missing PACKAGES into `package-user-dir', then load them."
  (setq package-user-dir (expand-file-name "elpa" mcpkit-test-runner--deps-dir))
  (setq package-archives '(("gnu" . "https://elpa.gnu.org/packages/")
                           ("melpa" . "https://melpa.org/packages/")
                           ("nongnu" . "https://elpa.nongnu.org/nongnu/")))
  (setq package-check-signature nil)
  (package-initialize)
  (let ((has-compat (file-expand-wildcards (expand-file-name "compat-*" package-user-dir)))
        (missing (seq-remove #'package-installed-p mcpkit-test-runner--packages)))
    (when (or missing (not has-compat))
      (package-refresh-contents)
      (unless has-compat
        (let ((compat-desc (cadr (assq 'compat package-archive-contents))))
          (when compat-desc
            (condition-case nil
                (package-install compat-desc)
              (error nil)))))
      (package-initialize)
      (require 'compat nil t)
      (seq-do #'package-install missing)
      (package-initialize))))

(mcpkit-test-runner--ensure-packages)

(require 'compat nil t)

(add-to-list 'load-path mcpkit-test-runner--root)

(seq-do (lambda (file) (load file nil t))
        (directory-files (file-name-concat mcpkit-test-runner--root "test")
                         t "\\`test-.*\\.el\\'"))

(ert-run-tests-batch-and-exit "^mcpkit")

;;; run-tests ends here
